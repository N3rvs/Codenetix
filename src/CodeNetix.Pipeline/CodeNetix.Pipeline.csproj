<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="CodeNetix.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="YamlDotNet" />
    <!-- Solo para generar migraciones con dotnet-ef; no viaja con el binario. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Esquema público de codenetix.yml (schemas/codenetix.v1.json), incrustado para validar sin red. -->
    <EmbeddedResource Include="..\..\schemas\codenetix.v1.json" LogicalName="CodeNetix.Pipeline.codenetix.v1.json" Link="Configuration\codenetix.v1.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeNetix.Contracts\CodeNetix.Contracts.csproj" />
  </ItemGroup>

</Project>
